# Urban Furniture Accounting System — Environment Variables
# Copy this file to .env and fill in production values.

# Database (default: SQLite for local dev)
DATABASE_URL=sqlite:///./urban_accounting.db
# For Postgres via Docker: postgresql://postgres:postgres@db:5432/urban_accounting

# JWT Authentication
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Docker Compose — Postgres settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urban_accounting
