{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Run Urban Furniture Backend",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Python: Seed Database",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/seed.py",
            "console": "integratedTerminal"
        }
    ]
}
